{
  "manifest_version": 3,
  "name": "Stream Drops Hub",
  "version": "1.5.8",
  "description": "치지직(CHZZK), SOOP, 트위치(Twitch)에서 지금 즉시 수령 가능한 드롭스 보상을 한곳에 모아보고 간편/자동 수령을 제공합니다.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Stream Drops Hub"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "cookies",
    "tabs",
    "clipboardWrite",
    "webRequest",
    "scripting"
  ],
  "host_permissions": [
    "https://*.twitch.tv/*",
    "https://twitch.tv/*",
    "https://*.naver.com/*",
    "https://naver.com/*",
    "https://*.chzzk.naver.com/*",
    "https://*.game.naver.com/*",
    "https://*.sooplive.com/*",
    "https://sooplive.com/*",
    "https://*.sooplive.co.kr/*",
    "https://sooplive.co.kr/*",
    "https://*.afreecatv.com/*",
    "https://afreecatv.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "minimum_chrome_version": "120"
}
