{
  "manifest_version": 3,
  "name": "Stream Drops Hub",
  "version": "1.5.16",
  "description": "치지직(CHZZK), SOOP, 트위치(Twitch) 드롭스를 한곳에서 확인하고 이터널리턴 방송을 자동 시청합니다.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Stream Drops Hub"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "cookies",
    "tabs",
    "clipboardWrite",
    "webRequest",
    "scripting"
  ],
  "host_permissions": [
    "https://*.twitch.tv/*",
    "https://twitch.tv/*",
    "https://*.naver.com/*",
    "https://naver.com/*",
    "https://*.chzzk.naver.com/*",
    "https://*.game.naver.com/*",
    "https://*.sooplive.com/*",
    "https://sooplive.com/*",
    "https://*.sooplive.co.kr/*",
    "https://sooplive.co.kr/*",
    "https://*.afreecatv.com/*",
    "https://afreecatv.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "minimum_chrome_version": "120"
}
